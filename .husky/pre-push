#!/usr/bin/env sh
# Pre-push: axis-1 verification (replaces retired GH Actions ci.yml/build-gates.yml/tsc-typecheck.yml).
# Per ~PLATFORM-PACKAGE-PIN-CONVENTION-README §6: git-dep package — hooks are COMMITTED, not
# installed (no husky devDep, no prepare/postinstall). Enable per clone with:
#     git config core.hooksPath .husky
# CRITICAL: tsc --noEmit runs STANDALONE (axis-1, memory:
# feedback-three-axis-railway-build-vs-gh-actions-vs-health-commit).

set -e


# ── GUARD 0 — HOOK REACHABILITY (the worktree gap) ───────────────────────────
# Costs ~20ms. First, because everything below is worthless if the file git
# executes is absent from the checkout doing the pushing.
#
# MEASURED IN Rello 2026-08-05, ported here: `core.hooksPath` is REPO-level
# config shared with every linked worktree, but husky's default value `.husky/_`
# is an UNTRACKED directory generated by `npm install`. A `git worktree add`
# checkout therefore inherits the path and does NOT have the directory, so git
# finds no hooks and `git push` completes at exit 0 with ZERO output —
# byte-identical to a repo with no hooks at all, and strictly worse than
# `--no-verify`, which at least requires someone to type it.
#
# The invariant is not "hooksPath equals a string" but the property that
# matters: THE HOOK GIT RUNS MUST BE A TRACKED FILE, so every checkout and every
# worktree has it by construction.
#
# SELF-HEALING rather than blocking. Rello's first version failed the push and
# told the operator to run one command. Platform-wide that would block every
# seat whose config still says `.husky/_` — including seats mid-task on other
# branches — for a condition they did not cause. Here the hook repairs the
# shared config itself and says so loudly; it only fails if the repair fails,
# because at that point it genuinely cannot verify anything.
_hooks_path=$(git config core.hooksPath 2>/dev/null || true)
[ -n "$_hooks_path" ] || _hooks_path=".git/hooks"
if ! git ls-files --error-unmatch "$_hooks_path/pre-push" >/dev/null 2>&1; then
  echo "[pre-push] hooks were resolving via '$_hooks_path' (untracked) — repairing to the tracked .husky"
  echo "[pre-push]   Until now, any 'git worktree add' checkout of this repo pushed with NO hooks and no output."
  if git config core.hooksPath .husky && git ls-files --error-unmatch ".husky/pre-push" >/dev/null 2>&1; then
    echo "[pre-push]   Repaired. This fixes every worktree of this clone at once."
  else
    echo "[pre-push] ✗ could not repair core.hooksPath — refusing to run an unverifiable push." >&2
    exit 1
  fi
fi

# With hooks now reachable from a worktree the hook RUNS there, but a fresh
# `git worktree add` has no node_modules, so the gates below die on a bare
# "sh: tsx: command not found" that reads like a broken hook rather than an
# unverifiable checkout. Name it instead.
if [ ! -d node_modules ]; then
  echo ""
  echo "[pre-push] ✗ CANNOT VERIFY — no node_modules in this checkout."
  echo "  cwd: $(pwd)"
  echo "  Hooks are reachable (good) but no gate can run, so this push cannot be"
  echo "  verified. This is the normal state of a fresh 'git worktree add' dir."
  echo "  Run 'npm ci' here, or push from a checkout that has dependencies."
  echo "  NOT verified is NOT the same as fine — that conflation is why this exists."
  echo ""
  exit 1
fi

echo "[pre-push] tsc --noEmit..."
npx tsc --noEmit

echo "[pre-push] npm run compile..."
npm run compile

echo "[pre-push] npm test..."
npm test

echo "[pre-push] dist/ committed check..."
if [ -z "$(git ls-files dist/)" ]; then
  echo "[pre-push] FAIL: dist/ is not committed. git-dep consumers install built output directly."
  exit 1
fi

echo "[pre-push] All checks passed."
